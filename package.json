{
  "name": "the-kut-shoppe-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "review": "npm run build && node scripts/review.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "bundlecheck": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run bundlecheck && npm run productioncheck && npm run workercheck",
    "productioncheck": "node scripts/check-production.mjs",
    "workercheck": "node scripts/check-worker.mjs && node scripts/check-notifications.mjs",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply DB --local",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "miniflare": "5.20260908.0-alpha",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.130.0"
  }
}

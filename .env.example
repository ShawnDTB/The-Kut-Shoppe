# Copy this file to .env and fill in values as needed.
# All variables are optional for local development.

# Overrides the disposable local Owner preview account created only in
# Vite development mode (see README > Local development).
# Defaults: owner@thekutshoppe.local / KutShoppeOwner!2026
VITE_DEV_MASTER_EMAIL=
VITE_DEV_MASTER_PASSWORD=

# Enables Google Places address autocomplete on the checkout address form.
# Without a key, the form falls back to plain browser autofill.
VITE_GOOGLE_PLACES_API_KEY=
